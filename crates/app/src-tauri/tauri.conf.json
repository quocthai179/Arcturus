{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcturus",
  "version": "0.1.0",
  "identifier": "dev.arcturus.app",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../../ui/dist",
    "beforeDevCommand": "pnpm -C ../../ui dev",
    "beforeBuildCommand": "pnpm -C ../../ui build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:* blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
