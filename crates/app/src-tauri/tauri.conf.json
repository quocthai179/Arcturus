{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcturus",
  "version": "0.1.0",
  "identifier": "dev.arcturus.app",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../../ui/dist",
    "beforeDevCommand": "pnpm -C ../../ui dev",
    "beforeBuildCommand": "pnpm -C ../../ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arcturus",
        "width": 420,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
