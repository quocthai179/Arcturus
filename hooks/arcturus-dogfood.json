{
  "_comment": "Cài bằng scripts/dogfood-install.sh (gộp có sao lưu vào ~/.claude/settings.json), gỡ bằng scripts/dogfood-uninstall.sh; hướng dẫn ở docs/DOGFOOD.md. Cần biến môi trường ARCTURUS_TOKEN lúc chạy claude. Hub tắt cũng an toàn: hook lỗi là lỗi không chặn. SessionStart dùng hook command + curl vì hook http không chạy cho SessionStart (docs/HOOK_FINDINGS.md F1).",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7878/hooks/permission",
            "timeout": 120,
            "headers": { "Authorization": "Bearer $ARCTURUS_TOKEN" },
            "allowedEnvVars": ["ARCTURUS_TOKEN"]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 3 -o /dev/null -X POST -H \"Authorization: Bearer $ARCTURUS_TOKEN\" -H \"Content-Type: application/json\" --data-binary @- http://127.0.0.1:7878/hooks/event || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7878/hooks/event", "timeout": 3, "headers": { "Authorization": "Bearer $ARCTURUS_TOKEN" }, "allowedEnvVars": ["ARCTURUS_TOKEN"] } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7878/hooks/event", "timeout": 3, "headers": { "Authorization": "Bearer $ARCTURUS_TOKEN" }, "allowedEnvVars": ["ARCTURUS_TOKEN"] } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7878/hooks/event", "timeout": 3, "headers": { "Authorization": "Bearer $ARCTURUS_TOKEN" }, "allowedEnvVars": ["ARCTURUS_TOKEN"] } ] }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7878/hooks/event", "timeout": 3, "headers": { "Authorization": "Bearer $ARCTURUS_TOKEN" }, "allowedEnvVars": ["ARCTURUS_TOKEN"] } ] }
    ],
    "Notification": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7878/hooks/event", "timeout": 3, "headers": { "Authorization": "Bearer $ARCTURUS_TOKEN" }, "allowedEnvVars": ["ARCTURUS_TOKEN"] } ] }
    ],
    "SubagentStart": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7878/hooks/event", "timeout": 3, "headers": { "Authorization": "Bearer $ARCTURUS_TOKEN" }, "allowedEnvVars": ["ARCTURUS_TOKEN"] } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7878/hooks/event", "timeout": 3, "headers": { "Authorization": "Bearer $ARCTURUS_TOKEN" }, "allowedEnvVars": ["ARCTURUS_TOKEN"] } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7878/hooks/event", "timeout": 3, "headers": { "Authorization": "Bearer $ARCTURUS_TOKEN" }, "allowedEnvVars": ["ARCTURUS_TOKEN"] } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7878/hooks/event", "timeout": 3, "headers": { "Authorization": "Bearer $ARCTURUS_TOKEN" }, "allowedEnvVars": ["ARCTURUS_TOKEN"] } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "http", "url": "http://127.0.0.1:7878/hooks/event", "timeout": 2, "headers": { "Authorization": "Bearer $ARCTURUS_TOKEN" }, "allowedEnvVars": ["ARCTURUS_TOKEN"] } ] }
    ]
  }
}
