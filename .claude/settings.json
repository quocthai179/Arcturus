      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo run -p replay *)",
      "Bash(cargo tree *)",
      "Bash(pnpm -C ui *)",
      "Bash(pnpm install *)",
      "Bash(git status *)",
